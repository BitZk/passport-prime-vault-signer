import { Theme, UISize, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Card } from "@ui/card.slint";
import { Navigate } from "../../gen/navigate.slint";

export component FlowPage inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        padding-top: Theme.spacing-xl + UISize.control-center-status-bar-height;
        padding-bottom: Theme.spacing-xl;
        spacing: Theme.spacing-md;

        Text {
            text: "Intended flow";
            color: Theme.palette-foreground;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-title;
            font-weight: Theme.font-weight-bold;
            horizontal-alignment: center;
        }

        Card {
            width: 100%;
            size: ControlSize.md;
            title: "1  Select";
            body: "Bitcoin Wallet opens Vault in a Bitcoin-seed selection mode.";
        }

        Card {
            width: 100%;
            size: ControlSize.md;
            title: "2  Verify";
            body: "Prime shows the Vault label and master fingerprint before activation.";
        }

        Card {
            width: 100%;
            size: ControlSize.md;
            title: "3  Sign";
            body: "The existing Bitcoin Wallet handles QR, files, QuantumLink, accounts, and PSBTs.";
        }

        Card {
            width: 100%;
            size: ControlSize.md;
            title: "4  Clear";
            body: "Manual clear or shutdown destroys the temporary session and restores the primary seed.";
        }

        Rectangle { vertical-stretch: 1; }

        Button {
            width: 100%;
            text: "Back";
            size: ControlSize.md;
            full-width: true;
            clicked => { Navigate.backward(); }
        }
    }
}
